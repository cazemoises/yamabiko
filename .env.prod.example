# Template para .env.prod (não commitado, ver .gitignore) — usado por
# `docker compose -f docker-compose.prod.yml --env-file .env.prod ...`.
# Copie pra .env.prod e preencha com valores reais antes do primeiro deploy
# na VM. Nunca reaproveitar os valores de dev do docker-compose.yml
# (POSTGRES_PASSWORD=yamabiko).
#
# Sem JWT_SECRET: login por senha/PIN foi removido (Sec. pedida pelo
# usuário — identidade agora vem dos headers Remote-Email/Remote-Name que o
# Pangolin injeta, ver core-api/internal/auth/context.go). O core-api só
# deve ser alcançável através do Pangolin/newt — nenhuma porta publicada
# neste compose, ver comentário do serviço core-api.

POSTGRES_USER=yamabiko
POSTGRES_PASSWORD=
POSTGRES_DB=yamabiko
