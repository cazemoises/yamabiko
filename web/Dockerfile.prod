# Serve o dist/ via nginx próprio (substituiu o esquema antigo de publicar
# num volume externo montado pelo nginx do Ascend — esse projeto não roda
# nesta VM). O Caddy da VM (ver infra-proxy/Caddyfile) faz reverse_proxy
# direto pro nome deste container na rede externa `shared-services`, mesmo
# padrão usado por caderninho-frontend e xiquexique-frontend.
FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
# VITE_BASE_PATH e VITE_API_BASE_URL só existem nesta imagem de produção —
# dev (`npm run dev`) e os testes e2e nunca setam essas ARGs, então
# continuam servindo em '/' com API relativa ao host que carregou a página
# (ver web/vite.config.ts e web/src/lib/apiClient.ts). Em produção,
# VITE_API_BASE_URL=/api é resolvido same-origin pelo Caddy (ver Caddyfile),
# então nenhum CORS é necessário.
ARG VITE_BASE_PATH=/
ARG VITE_API_BASE_URL=
ENV VITE_BASE_PATH=${VITE_BASE_PATH}
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npx tsc -b && npx vite build

FROM nginx:1.27-alpine
# curl instalado explicitamente pro HEALTHCHECK abaixo — a imagem base
# nginx:alpine não garante ter wget/curl no PATH (foi o que causou o
# healthcheck via `docker compose exec ... wget` falhar silenciosamente).
RUN apk add --no-cache curl
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=3s --timeout=3s --retries=10 CMD curl -sf http://localhost/ || exit 1