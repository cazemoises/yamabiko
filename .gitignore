venv/
__pycache__/
*.pyc
.env
.env.prod
*.wav
*.mp3
core-api/tmp/
web/node_modules/
web/dist/
.DS_Store

# Certificados TLS locais (ex: gerados via `tailscale cert`, ver
# BUILD_STATE.md) — a chave privada nunca pode ir pro repositório; o
# certificado público também fica de fora por simplicidade (é regenerado
# localmente, não precisa estar versionado).
*.key
*.crt
*.pem

# Override local do docker-compose (monta o certificado TLS acima no
# core-api) — específico desta máquina/rede Tailscale, não portável, nunca
# comitado. docker compose lê docker-compose.yml + docker-compose.override.yml
# automaticamente quando o 2º existe; sem ele, `docker compose up` usa só o
# base (sem TLS), então um clone novo do repo nunca quebra por causa disso.
docker-compose.override.yml
